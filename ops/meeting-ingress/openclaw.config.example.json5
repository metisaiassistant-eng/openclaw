{
  plugins: {
    entries: {
      "meeting-workflow": {
        enabled: true,
        config: {
          enabled: true,
          maxBodyBytes: 1048576,
          accounts: [
            {
              accountKey: "acme-team",
              label: "Acme Team",
              email: "meetings+acme@example.com",
              routePath: "/integrations/source/fathom/acme-team/webhook",
              provider: "fathom",
              fathom: {
                apiKey: "${SOURCE_FATHOM_ACME_TEAM_API_KEY}",
                webhookSecret: "${SOURCE_FATHOM_ACME_TEAM_WEBHOOK_SECRET}",
                baseUrl: "https://api.fathom.ai/external/v1",
              },
              documents: {
                provider: "google_docs",
                googleDocs: {
                  rootFolderId: "${DOCUMENT_GOOGLE_DOCS_ACME_TEAM_ROOT_FOLDER_ID}",
                  accessToken: "${DOCUMENT_GOOGLE_DOCS_ACME_TEAM_ACCESS_TOKEN}",
                  titlePrefix: "Meeting",
                },
              },
              tasks: {
                provider: "clickup",
                clickup: {
                  listId: "${TASK_CLICKUP_ACME_TEAM_LIST_ID}",
                  apiKey: "${TASK_CLICKUP_ACME_TEAM_API_KEY}",
                  assigneeIds: [
                    "${TASK_CLICKUP_ACME_TEAM_ASSIGNEE_1}",
                    "${TASK_CLICKUP_ACME_TEAM_ASSIGNEE_2}",
                  ],
                },
              },
              models: {
                summary: {
                  model: "openai/gpt-5.2-mini",
                  thinking: "low",
                },
                actionItems: {
                  model: "openai/gpt-5.4",
                  thinking: "medium",
                },
              },
            },
            {
              accountKey: "beta-team",
              label: "Beta Team",
              email: "meetings+beta@example.com",
              routePath: "/integrations/source/fathom/beta-team/webhook",
              provider: "fathom",
              fathom: {
                apiKey: "${SOURCE_FATHOM_BETA_TEAM_API_KEY}",
                webhookSecret: "${SOURCE_FATHOM_BETA_TEAM_WEBHOOK_SECRET}",
                baseUrl: "https://api.fathom.ai/external/v1",
              },
              documents: {
                provider: "google_docs",
                googleDocs: {
                  rootFolderId: "${DOCUMENT_GOOGLE_DOCS_BETA_TEAM_ROOT_FOLDER_ID}",
                  accessToken: "${DOCUMENT_GOOGLE_DOCS_BETA_TEAM_ACCESS_TOKEN}",
                  titlePrefix: "Meeting",
                },
              },
              tasks: {
                provider: "clickup",
                clickup: {
                  listId: "${TASK_CLICKUP_BETA_TEAM_LIST_ID}",
                  apiKey: "${TASK_CLICKUP_BETA_TEAM_API_KEY}",
                  assigneeIds: [
                    "${TASK_CLICKUP_BETA_TEAM_ASSIGNEE_1}",
                    "${TASK_CLICKUP_BETA_TEAM_ASSIGNEE_2}",
                  ],
                },
              },
              models: {
                summary: {
                  model: "openai/gpt-5.2-mini",
                  thinking: "low",
                },
                actionItems: {
                  model: "openai/gpt-5.4",
                  thinking: "medium",
                },
              },
            },
          ],
        },
      },
    },
  },
}
