{
  plugins: {
    entries: {
      "meeting-workflow": {
        enabled: true,
        config: {
          enabled: true,
          maxBodyBytes: 1048576,
          forward: {
            hooksBaseUrl: "http://127.0.0.1:18789",
            hooksPath: "/hooks/meeting-source",
            hooksToken: "${OPENCLAW_HOOKS_TOKEN}",
            timeoutMs: 10000,
          },
          accounts: [
            {
              accountKey: "cirruslabs-deloitte",
              label: "CirrusLabs / Deloitte",
              email: "me+cirruslabs@example.com",
              routePath: "/integrations/source/fathom/cirruslabs-deloitte/webhook",
              provider: "fathom",
              fathom: {
                apiKey: "${SOURCE_FATHOM_CIRRUSLABS_DELOITTE_API_KEY}",
                webhookSecret: "${SOURCE_FATHOM_CIRRUSLABS_DELOITTE_WEBHOOK_SECRET}",
                baseUrl: "https://api.fathom.ai/external/v1",
              },
              documents: {
                provider: "google_docs",
                googleDocs: {
                  rootFolderId: "${DOCUMENT_GOOGLE_DOCS_CIRRUSLABS_DELOITTE_ROOT_FOLDER_ID}",
                  accessToken: "${DOCUMENT_GOOGLE_DOCS_CIRRUSLABS_DELOITTE_ACCESS_TOKEN}",
                  refreshToken: "${DOCUMENT_GOOGLE_DOCS_CIRRUSLABS_DELOITTE_REFRESH_TOKEN}",
                  clientId: "${DOCUMENT_GOOGLE_DOCS_CIRRUSLABS_DELOITTE_CLIENT_ID}",
                  clientSecret: "${DOCUMENT_GOOGLE_DOCS_CIRRUSLABS_DELOITTE_CLIENT_SECRET}",
                  titlePrefix: "Meeting",
                },
              },
              tasks: {
                provider: "clickup",
                clickup: {
                  listId: "${TASK_CLICKUP_CIRRUSLABS_DELOITTE_LIST_ID}",
                  apiKey: "${TASK_CLICKUP_CIRRUSLABS_DELOITTE_API_KEY}",
                  assigneeIds: [
                    "${TASK_CLICKUP_CIRRUSLABS_DELOITTE_ASSIGNEE_1}",
                    "${TASK_CLICKUP_CIRRUSLABS_DELOITTE_ASSIGNEE_2}",
                  ],
                },
              },
              models: {
                summary: {
                  model: "openai/gpt-5.2-mini",
                  thinking: "low",
                },
                actionItems: {
                  model: "openai/gpt-5.4",
                  thinking: "medium",
                },
              },
            },
            {
              accountKey: "prediktive-accela",
              label: "Prediktive / Accela",
              email: "me+prediktive@example.com",
              routePath: "/integrations/source/fathom/prediktive-accela/webhook",
              provider: "fathom",
              fathom: {
                apiKey: "${SOURCE_FATHOM_PREDIKTIVE_ACCELA_API_KEY}",
                webhookSecret: "${SOURCE_FATHOM_PREDIKTIVE_ACCELA_WEBHOOK_SECRET}",
                baseUrl: "https://api.fathom.ai/external/v1",
              },
              documents: {
                provider: "google_docs",
                googleDocs: {
                  rootFolderId: "${DOCUMENT_GOOGLE_DOCS_PREDIKTIVE_ACCELA_ROOT_FOLDER_ID}",
                  accessToken: "${DOCUMENT_GOOGLE_DOCS_PREDIKTIVE_ACCELA_ACCESS_TOKEN}",
                  refreshToken: "${DOCUMENT_GOOGLE_DOCS_PREDIKTIVE_ACCELA_REFRESH_TOKEN}",
                  clientId: "${DOCUMENT_GOOGLE_DOCS_PREDIKTIVE_ACCELA_CLIENT_ID}",
                  clientSecret: "${DOCUMENT_GOOGLE_DOCS_PREDIKTIVE_ACCELA_CLIENT_SECRET}",
                  titlePrefix: "Meeting",
                },
              },
              tasks: {
                provider: "clickup",
                clickup: {
                  listId: "${TASK_CLICKUP_PREDIKTIVE_ACCELA_LIST_ID}",
                  apiKey: "${TASK_CLICKUP_PREDIKTIVE_ACCELA_API_KEY}",
                  assigneeIds: [
                    "${TASK_CLICKUP_PREDIKTIVE_ACCELA_ASSIGNEE_1}",
                    "${TASK_CLICKUP_PREDIKTIVE_ACCELA_ASSIGNEE_2}",
                  ],
                },
              },
              models: {
                summary: {
                  model: "openai/gpt-5.2-mini",
                  thinking: "low",
                },
                actionItems: {
                  model: "openai/gpt-5.4",
                  thinking: "medium",
                },
              },
            },
          ],
        },
      },
    },
  },
}
